generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_LOCAL")
}

model Pelanggan {
  id        String      @id @default(cuid())
  nama      String
  noWa      String      @unique
  alamat    String      @db.Text
  waVerified Boolean    @default(false)
  otpCode   String?
  createdAt DateTime    @default(now())
  transaksi Transaksi[]
}

model Outlet {
  id             String           @id @default(cuid())
  nama           String
  kode           String           @unique
  alamat         String           @db.Text
  kota           String
  isActive       Boolean          @default(true)
  antreanCounter AntreanCounter[]
  transaksi      Transaksi[]
  users          User[]
  hargaOutlet    HargaOutlet[]
}

model Produk {
  id             String          @id @default(cuid())
  nama           String
  hargaDefault   Int
  isActive       Boolean         @default(true)
  hargaOutlet    HargaOutlet[]
  detailTransaksi DetailTransaksi[]
}

model HargaOutlet {
  id        String  @id @default(cuid())
  outletId  String
  produkId  String
  harga     Int
  stok      Int     @default(100)
  outlet    Outlet  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  produk    Produk  @relation(fields: [produkId], references: [id], onDelete: Cascade)

  @@unique([outletId, produkId])
}

model User {
  id       String  @id @default(cuid())
  nama     String
  email    String  @unique
  password String
  role     Role
  outletId String?
  outlet   Outlet? @relation(fields: [outletId], references: [id])
}

model AntreanCounter {
  id       String   @id @default(cuid())
  outletId String
  tanggal  DateTime @db.Date
  counter  Int      @default(0)
  outlet   Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, tanggal])
}

model Transaksi {
  id               String            @id @default(cuid())
  noAntrean        String            @unique
  barcode          String            @unique
  outletId         String
  pelangganId      String
  tanggal          DateTime          @default(now())
  estimasiSelesai  DateTime
  total            Int
  status           StatusTransaksi   @default(MENUNGGU)
  outlet           Outlet            @relation(fields: [outletId], references: [id])
  pelanggan        Pelanggan         @relation(fields: [pelangganId], references: [id])
  items            DetailTransaksi[]
}

model DetailTransaksi {
  id            String    @id @default(cuid())
  transaksiId   String
  produkId      String
  qty           Int
  hargaSatuan   Int
  subtotal      Int
  transaksi     Transaksi @relation(fields: [transaksiId], references: [id], onDelete: Cascade)
  produk        Produk    @relation(fields: [produkId], references: [id])
}

enum Role {
  ADMIN
  KARYAWAN
}

enum StatusTransaksi {
  MENUNGGU
  DIPROSES
  SELESAI
  BATAL
}
