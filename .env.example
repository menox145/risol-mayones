# Copy this file to .env.local for local development.
# For Vercel, set the same variables in Project > Settings > Environment Variables.

DATABASE_URL_NEON="postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require"
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require"

SESSION_COOKIE_NAME="risol_session_user"
SESSION_MAX_AGE="604800"

NEXTAUTH_SECRET="generate-random-secret-here"
NEXTAUTH_URL="https://your-app-name.vercel.app"
